{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Isolated IDguard multilingual teststore",
    "author": "IDguard"
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "7.1.4"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/teststore-isolation.php",
      "data": {
        "resource": "bundled",
        "path": "./isolation.php"
      }
    },
    {
      "step": "unzip",
      "zipFile": {
        "resource": "bundled",
        "path": "./woocommerce.zip"
      },
      "extractToPath": "/wordpress/wp-content/plugins"
    },
    {
      "step": "unzip",
      "zipFile": {
        "resource": "bundled",
        "path": "./idguard.zip"
      },
      "extractToPath": "/wordpress/wp-content/plugins"
    },
    {
      "step": "activatePlugin",
      "pluginPath": "woocommerce/woocommerce.php"
    },
    {
      "step": "activatePlugin",
      "pluginPath": "idguard/idguard.php"
    },
    {
      "step": "activateTheme",
      "themeFolderName": "idguard-shop"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; require '/setup/setup.php';"
    }
  ]
}
